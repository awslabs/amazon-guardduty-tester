{
  "schemaVersion": "2.0",
  "description": "Catalog of GuardDuty runtime-monitoring Custom Detection Rules and the tests that exercise them. A rule records the finding type its benign trigger is expected to produce. A test is the executable unit: it names the rule it exercises (ruleId), a benign trigger script, and the packages that trigger needs. Multiple tests may exercise one rule (e.g. one per watched path). Account id and region are never stored here; they are resolved at runtime.",
  "scope": {
    "description": "A test is in scope for a (compute type, OS) pair unless either dimension excludes its rule (default: in scope). Compute types and OS types are independent; rule exclusions key by testId and carry a reason. The compute-type reason wins if both exclude.",
    "computeTypes": {
      "ec2": {
        "ruleExclusions": {}
      }
    },
    "osTypes": {
      "al2023": {
        "ruleExclusions": {
          "DnsTunnelingToolExecuted": "iodine/dns2tcp are not in the AL2023 repos; tested on Ubuntu only",
          "SshFromPublicIPAddress": "the scenario logs in as the 'ubuntu' user, which Amazon Linux does not have; tested on Ubuntu only"
        }
      },
      "ubuntu2204": {
        "ruleExclusions": {}
      }
    }
  },
